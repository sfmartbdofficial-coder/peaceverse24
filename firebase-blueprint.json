{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in Peace World",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "avatar": { "type": "string" },
        "coverPhoto": { "type": "string" },
        "bio": { "type": "string" },
        "whatsapp": { "type": "string" },
        "imo": { "type": "string" },
        "viber": { "type": "string" },
        "messengerLink": { "type": "string" },
        "contactPrivacy": {
          "type": "string",
          "enum": ["public", "friends", "private"]
        },
        "isVerified": { "type": "boolean" },
        "friends": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "Post": {
      "title": "Post",
      "description": "Social media post in Peace World",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "authorVerified": { "type": "boolean" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "videoUrl": { "type": "string" },
        "privacy": {
          "type": "string",
          "enum": ["public", "friends", "private"]
        },
        "status": {
          "type": "string",
          "enum": ["approved", "blocked", "rejected"]
        },
        "moderationReason": { "type": "string" },
        "isQuranVerse": { "type": "boolean" },
        "quranVerseTranslation": { "type": "string" },
        "likesCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "sharesCount": { "type": "number" },
        "likes": { "type": "array" },
        "typingUsers": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "authorId", "authorName", "content", "privacy", "status"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Instant comment on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "text": { "type": "string" },
        "likesCount": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "authorId", "authorName", "text"]
    },
    "Notification": {
      "title": "Notification",
      "description": "Realtime notification for interactions, broadcasts, and moderation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "recipientId": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "senderAvatar": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["like", "comment", "share", "follow", "moderation", "new_post", "broadcast"]
        },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "image": { "type": "string" },
        "link": { "type": "string" },
        "postId": { "type": "string" },
        "read": { "type": "boolean" },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "type", "message"]
    },
    "Appeal": {
      "title": "Appeal",
      "description": "User appeal for rejected or blocked posts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "reason": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "resolved"]
        },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "postId", "userId", "userName", "reason"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Follow relationship between users and creators",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "followerId": { "type": "string" },
        "followerName": { "type": "string" },
        "followerAvatar": { "type": "string" },
        "targetId": { "type": "string" },
        "targetName": { "type": "string" },
        "targetAvatar": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "followerId", "targetId"]
    },
    "LinkHistoryItem": {
      "title": "LinkHistoryItem",
      "description": "Real visited link saved for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string" },
        "visitedAt": { "type": "string" },
        "createdAtMillis": { "type": "number" }
      },
      "required": ["id", "userId", "url"]
    },
    "ActivityLogItem": {
      "title": "ActivityLogItem",
      "description": "Real user action recorded in activity log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "category": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdAtMillis": { "type": "number" }
      },
      "required": ["id", "userId", "category", "text"]
    },
    "UserOrder": {
      "title": "UserOrder",
      "description": "Real marketplace order for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "shopName": { "type": "string" },
        "itemsSummary": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdAtMillis": { "type": "number" }
      },
      "required": ["id", "userId", "amount", "paymentMethod", "status"]
    },
    "UserSettings": {
      "title": "UserSettings",
      "description": "Per-user settings and payment numbers",
      "type": "object",
      "properties": {
        "bkashNumber": { "type": "string" },
        "nagadNumber": { "type": "string" },
        "defaultPaymentMethod": { "type": "string" },
        "notifyFavoriteCreator": { "type": "boolean" },
        "notifyPriyoDada": { "type": "boolean" },
        "notifSound": { "type": "boolean" },
        "notifVibration": { "type": "boolean" },
        "creatorNotifyFollowersOnPost": { "type": "boolean" },
        "creatorSendPushToAllUsers": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "MobileSimStatus": {
      "title": "MobileSimStatus",
      "description": "Real carrier/SIM data status linked by user",
      "type": "object",
      "properties": {
        "operator": { "type": "string" },
        "dataBalance": { "type": "string" },
        "expiry": { "type": "string" },
        "simDetected": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles"
    },
    "/users/{userId}/link_history/{linkId}": {
      "schema": "LinkHistoryItem",
      "description": "User visited link history"
    },
    "/users/{userId}/activity_log/{activityId}": {
      "schema": "ActivityLogItem",
      "description": "User activity log entries"
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": "UserOrder",
      "description": "User marketplace orders"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "UserSettings",
      "description": "User settings and payment preferences"
    },
    "/users/{userId}/mobile_sim/{simId}": {
      "schema": "MobileSimStatus",
      "description": "User mobile carrier/SIM balance record"
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Posts collection with privacy and moderation status"
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": "Comment",
      "description": "Live comments for each post"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Real-time user notifications"
    },
    "/appeals/{appealId}": {
      "schema": "Appeal",
      "description": "Content moderation appeals"
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "User follow relationships and subscriber graph"
    }
  }
}
