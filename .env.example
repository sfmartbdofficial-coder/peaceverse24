# API_KEY: Set API keys in Vercel Environment Variables, not in code
API_KEY="YOUR_API_KEY"
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://peaceverse24.com"

# Authorized Admin Email (only this Firebase verified email can access /admin)
VITE_ADMIN_EMAIL="your-admin-email@example.com"

# Cloudflare Turnstile & Origin Guard
# Enable Cloudflare Bot Fight Mode + Rate Limit 10 req/sec in dashboard
VITE_TURNSTILE_SITE_KEY="YOUR_KEY"
REQUIRE_CLOUDFLARE_ORIGIN="false"

# Bunny.net Storage, Stream & CDN (Keep Storage/Stream API keys server-side only)
BUNNY_STORAGE_ZONE=""
BUNNY_STORAGE_API_KEY=""
BUNNY_STORAGE_REGION="de"
BUNNY_CDN_URL=""
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOST=""
VITE_BUNNY_TOKEN=""

# Firebase Client Configuration + App Check (Set in Vercel Environment Variables)
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="1:000000000000:web:000000000000"
VITE_FIREBASE_APPCHECK_SITE_KEY=""

# Supabase Client Configuration (Enable RLS on all tables)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Google Search Console Verification Code (optional if edited directly in index.html)
VITE_GOOGLE_SITE_VERIFICATION="YOUR_GOOGLE_SEARCH_CONSOLE_VERIFICATION_CODE"

# Real Email OTP Delivery (Configure at least ONE provider on Server / Vercel)
# Option 1: Resend (Recommended — get key from https://resend.com)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
RESEND_FROM_EMAIL="PeaceVerse24 <noreply@peaceverse24.com>"

# Option 2: Gmail / Custom SMTP via Nodemailer (Use Gmail App Password)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="YOUR_16_CHAR_GMAIL_APP_PASSWORD"
SMTP_FROM_EMAIL="PeaceVerse24 <your-gmail@gmail.com>"

# Option 3: EmailJS (Optional REST API fallback)
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
# ZegoCloud Live Rooms (Keep Server Secret on Server/Worker only)
ZEGO_APP_ID=""
ZEGO_SERVER_SECRET=""
