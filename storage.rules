rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource != null
        && (
          (request.resource.contentType.matches('image/.*') && !request.resource.contentType.matches('image/svg\\+xml') && request.resource.size <= 5 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 5 * 1024 * 1024)
        );
    }

    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource != null
        && (
          (request.resource.contentType.matches('image/.*') && !request.resource.contentType.matches('image/svg\\+xml') && request.resource.size <= 5 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size <= 50 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size <= 5 * 1024 * 1024)
        );
    }
  }
}
